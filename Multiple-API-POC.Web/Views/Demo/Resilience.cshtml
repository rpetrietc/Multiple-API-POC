@{
    ViewData["Title"] = "API Resilience Demo";
}

<h1>API Resilience Demo</h1>

<p>
    This page will demonstrate how the portal can continue operating
    when one of its dependent APIs
    is slow or unavailable.
</p>

<div class="mb-3">
    <a asp-controller="Demo"
       asp-action="RunResilience"
       class="btn btn-danger">
        Run Simulated Failure
    </a>

    <a asp-controller="Demo"
       asp-action="RunTransientResilience"
       class="btn btn-success">
        Run Temporary Failure + Recovery
    </a>
</div>

@if (ViewBag.Result != null)
{
    <div class="alert alert-warning">
        <strong>Result:</strong>
        @ViewBag.Result
    </div>
}

@if (ViewBag.TransientResult != null)
{
    <div class="alert alert-success">
        <strong>Recovery Result:</strong>
        @ViewBag.TransientResult
    </div>
}

<div class="card mt-4 mb-3">
    <div class="card-body">
        <h4 class="card-title">What this proves</h4>

        <ul class="mb-0">
            <li>
                <strong>Permanent failure:</strong>
                If a service remains unavailable, the portal can detect the failure
                and handle it without waiting indefinitely.
            </li>
            <li>
                <strong>Temporary failure:</strong>
                If a service has a short-lived problem, the resilience policy can
                automatically retry the request.
            </li>
            <li>
                <strong>Recovery:</strong>
                If the service becomes available again during a retry, the request
                can succeed without the user having to try again manually.
            </li>
            <li>
                <strong>Portal design:</strong>
                One unhealthy backend service should not prevent the portal from
                continuing to work with the services that are still available.
            </li>
        </ul>
    </div>
</div>

<a asp-controller="Demo"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Performance Demo
</a>