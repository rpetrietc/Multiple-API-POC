@model Multiple_API_POC.Web.Models.DemoViewModel

@{
    ViewData["Title"] = "Multiple API Demo";
}

<h1>Multiple API Performance Demo</h1>

<p>
    This page demonstrates different ways of retrieving information
    from four independent APIs.
</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="mb-4">
    <a asp-controller="Demo"
       asp-action="Sequential"
       class="btn btn-primary">
        Run Sequential
    </a>

    <a asp-controller="Demo"
       asp-action="Parallel"
       class="btn btn-success">
        Run Parallel
    </a>

    <a asp-controller="Demo"
       asp-action="Cached"
       class="btn btn-warning">
        Run Cached
    </a>

    <form asp-controller="Demo"
          asp-action="ClearCache"
          method="post"
          class="d-inline">

        <button type="submit"
                class="btn btn-secondary">
            Clear Cache
        </button>
    </form>

    <a asp-controller="Demo"
       asp-action="Comparison"
       class="btn btn-dark">
        Run Full Comparison
    </a>

    <a asp-controller="Demo"
       asp-action="Resilience"
       class="btn btn-info">
        Resilience Demo
    </a>
</div>



@if (Model.Results.Count > 0)
{
    <h2>@Model.Mode Results</h2>

    <p>
        <strong>Total elapsed time:</strong>
        <strong style="color:red">@Model.TotalElapsedMilliseconds ms</strong>  
    </p>

    @if (Model.Mode == "Sequential")
    {
        <div class="alert alert-primary">
            <strong>Pros:</strong>
            <ul class="mb-2">
                <li>Simple and easy to understand.</li>
                <li>Useful when one Application Programming Interface (API) call depends on another.</li>
                <li>Easier to follow and troubleshoot.</li>
            </ul>

            <strong>Cons:</strong>
            <ul class="mb-0">
                <li>Slower when the API calls are independent.</li>
                <li>Total response time is roughly the sum of all API call times.</li>
                <li>One slow API can delay everything that follows it.</li>
            </ul>
        </div>
    }
    else if (Model.Mode == "Parallel")
    {
        <div class="alert alert-success">
            <strong>Pros:</strong>
            <ul class="mb-2">
                <li>Independent Application Programming Interface (API) calls run at the same time.</li>
                <li>Total response time is closer to the slowest individual API call.</li>
                <li>Can significantly improve landing-page performance.</li>
            </ul>

            <strong>Cons:</strong>
            <ul class="mb-0">
                <li>Only appropriate when the API calls are independent.</li>
                <li>Creates multiple outbound requests at the same time.</li>
                <li>Error handling can be more complex if one API fails.</li>
            </ul>
        </div>
    }
    else if (Model.Mode == "Cached")
    {
        <div class="alert alert-warning">
            <strong>Pros:</strong>
            <ul class="mb-2">
                <li>Previously retrieved data can be returned very quickly.</li>
                <li>Reduces unnecessary Application Programming Interface (API) calls.</li>
                <li>Can reduce load on external systems and improve landing-page performance.</li>
            </ul>

            <strong>Cons:</strong>
            <ul class="mb-0">
                <li>The first request still needs to call the APIs when the cache is empty.</li>
                <li>Cached data may be slightly out of date until the cache expires.</li>
                <li>Cache duration needs to be chosen carefully based on how fresh the data must be.</li>
            </ul>
        </div>
    }
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>API</th>
                <th>Source</th>
                <th>Elapsed Time</th>
                <th>Response</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.Results)
            {
                <tr>
                    <td>@result.Name</td>
                    <td>@result.Source</td>
                    <td>@result.ElapsedMilliseconds ms</td>
                    <td>
                        <pre style="white-space: pre-wrap;">@result.Response</pre>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>
        Choose one of the options above to run the four API calls.
    </p>
}